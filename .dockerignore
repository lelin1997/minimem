# MiniMem — .dockerignore
# 减少构建上下文体积, 加速 docker build

# 依赖
node_modules/
**/node_modules/

# 构建产物
dist/
**/dist/
build/
**/build/

# 日志
*.log
logs/

# 环境变量 (敏感)
.env
.env.*
*.local.toml
*.local.json

# IDE
.vscode/
.idea/
.workbuddy/
.codebuddy/

# macOS
.DS_Store
__MACOSX/

# Git
.git/
.gitignore

# 测试
coverage/
**/coverage/
*.test.ts
tests/

# 文档 (不需要打进镜像)
docs/
*.md
!minimem/README.md

# 数据目录 (运行时生成)
data/
minimem/data/

# 临时文件
*.tmp
*.bak
*副本*
